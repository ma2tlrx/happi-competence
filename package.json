{
  "name": "happi-competence",
  "version": "1.0.0",
  "private": true,
  "description": "HAPPI Compétence — site vitrine et plateforme SaaS d'accompagnement et d'évaluation des compétences transversales.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test",
    "db:start": "node scripts/local-stack.mjs start",
    "db:stop": "node scripts/local-stack.mjs stop",
    "db:reset": "node scripts/local-stack.mjs reset",
    "db:status": "node scripts/local-stack.mjs status",
    "demo:seed": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "demo:purge": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs --purge",
    "admin:code": "node --env-file-if-exists=.env.local scripts/create-access-code.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
