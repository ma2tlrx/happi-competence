# ─────────────────────────────────────────────────────────────────────────────
# HAPPI Compétence — variables d'environnement
# Copiez ce fichier en .env.local (jamais versionné) et renseignez les valeurs.
# En local, `npm run db:start` crée .env.local automatiquement.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique du site (sans barre finale). Sert aux liens des e-mails et au SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Projet Supabase : Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (« anon » ou « publishable »). Elle peut être exposée au navigateur :
# la sécurité repose sur les politiques RLS de la base.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (« service_role » ou « secret »). SERVEUR UNIQUEMENT.
# Ne jamais la préfixer par NEXT_PUBLIC_ ni la versionner : elle contourne RLS.
# Utilisée pour : activation des codes d'accès, formulaire de contact,
# désactivation et suppression de comptes.
SUPABASE_SERVICE_ROLE_KEY=

# Affiche un bandeau « Environnement de démonstration » (données fictives).
NEXT_PUBLIC_DEMO_MODE=false

# Rédaction des bilans par IA. SERVEUR UNIQUEMENT (jamais de préfixe NEXT_PUBLIC_).
# OPENROUTER_API_KEY : passage par OpenRouter (prioritaire si renseignée).
# ANTHROPIC_API_KEY  : API Claude directe, si OpenRouter n'est pas utilisé.
# REPORT_AI_MODEL    : modèle, facultatif (défaut : anthropic/claude-opus-5.5 via
#                      OpenRouter, claude-opus-5-5 en direct).
# Sans clé, les bilans restent disponibles et se rédigent à la main.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
REPORT_AI_MODEL=
