# ─────────────────────────────────────────────────────────────────────────────
# HAPPI Compétence — variables d'environnement
# Copiez ce fichier en .env.local (jamais versionné) et renseignez les valeurs.
# En local, `npm run db:start` crée .env.local automatiquement.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique du site (sans barre finale). Sert aux liens des e-mails et au SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Projet Supabase : Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (« anon » ou « publishable »). Elle peut être exposée au navigateur :
# la sécurité repose sur les politiques RLS de la base.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (« service_role » ou « secret »). SERVEUR UNIQUEMENT.
# Ne jamais la préfixer par NEXT_PUBLIC_ ni la versionner : elle contourne RLS.
# Utilisée pour : activation des codes d'accès, formulaire de contact,
# désactivation et suppression de comptes.
SUPABASE_SERVICE_ROLE_KEY=

# Affiche un bandeau « Environnement de démonstration » (données fictives).
NEXT_PUBLIC_DEMO_MODE=false

# Rédaction des bilans par IA. SERVEUR UNIQUEMENT (jamais de préfixe NEXT_PUBLIC_).
# OPENROUTER_API_KEY : passage par OpenRouter (prioritaire si renseignée).
# ANTHROPIC_API_KEY  : API Claude directe, si OpenRouter n'est pas utilisé.
# REPORT_AI_MODEL    : modèle, facultatif (défaut : anthropic/claude-opus-5.5 via
#                      OpenRouter, claude-opus-5-5 en direct).
# Sans clé, les bilans restent disponibles et se rédigent à la main.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
REPORT_AI_MODEL=

# E-mails transactionnels (convocations, rappels J-1, séances modifiées, bilans,
# invitations). SERVEUR UNIQUEMENT. Voir docs/deploiement.md, section « E-mails ».
# EMAIL_PROVIDER : brevo | smtp | resend. Vide : mode « journal », aucun envoi
#                  (les messages sont tracés « non envoyés » dans Administration → E-mails).
# EMAIL_FROM     : expéditeur, adresse d'un domaine vérifié chez le fournisseur.
# BREVO_API_KEY  : clé API Brevo (EMAIL_PROVIDER=brevo).
# SMTP_URL       : smtp://utilisateur:motdepasse@hote:587 ou smtps://…:465 (EMAIL_PROVIDER=smtp).
#                  En local : smtp://localhost:54325 (Mailpit, consultable sur http://localhost:54324).
# RESEND_API_KEY : clé API Resend (EMAIL_PROVIDER=resend).
# CRON_SECRET    : secret aléatoire (32 caractères ou plus) protégeant /api/cron/rappels.
#                  Vercel l'envoie automatiquement aux tâches planifiées de vercel.json.
# Rappel : les e-mails d'authentification (confirmation, mot de passe oublié) sont envoyés
# par Supabase, qui doit aussi disposer d'un SMTP (Authentication → SMTP Settings).
EMAIL_PROVIDER=
EMAIL_FROM=
BREVO_API_KEY=
SMTP_URL=
RESEND_API_KEY=
CRON_SECRET=
